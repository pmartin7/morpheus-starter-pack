# Database
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Firebase Admin SDK (server — apps/api)
# The private key must keep its \n-escaped newlines when stored in env managers.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Firebase client SDK (browser — apps/web, from Firebase console > Project settings > Web app)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# AI Providers (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Which model to use — format: provider:model-id
# Examples: anthropic:claude-3-5-sonnet-20241022  openai:gpt-4o
DEFAULT_AI_MODEL=anthropic:claude-3-5-sonnet-20241022

# Observability (optional)
AXIOM_TOKEN=xaat-...
AXIOM_DATASET=forge-logs

# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Vercel Blob (optional — add-blob-storage skill)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
